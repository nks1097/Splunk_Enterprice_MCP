# ==============================================================================
# Splunk Enterprise MCP Server - Environment Configuration Template
# Copy this file to .env and configure for your Splunk Enterprise instance.
# ==============================================================================

# Splunk Connection Settings
SPLUNK_HOST=splunk.enterprise.corp
SPLUNK_PORT=8089
SPLUNK_SCHEME=https

# Authentication: Choose EITHER Bearer Token (Recommended) OR Username/Password
SPLUNK_TOKEN=your-splunk-bearer-token-here
# SPLUNK_USERNAME=svc_mcp_agent
# SPLUNK_PASSWORD=your-secure-password-here

# TLS Verification
SPLUNK_VERIFY_TLS=true
# SPLUNK_CA_BUNDLE=/etc/ssl/certs/enterprise-ca.crt

# Search Controls & Execution Bounds
SPLUNK_TIMEOUT=30.0
SPLUNK_MAX_RESULTS=1000
SPLUNK_MAX_CONCURRENT_SEARCHES=5
SPLUNK_DEFAULT_TIME_RANGE=-24h@h

# MCP Server Protocol & Governance
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8001
MCP_AUTH_MODE=none
MCP_AUDIT_ENABLED=true
MCP_LOG_LEVEL=INFO

# Security Enforcement: Read-Only Mode (true = Default, blocks all destructive/modifying operations)
MCP_READ_ONLY=true
